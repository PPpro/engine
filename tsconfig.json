{
  "compilerOptions": {
    "target": "es6",
    "lib": ["es2015", "es2017", "dom"],
    "module": "commonjs",
    "moduleResolution": "NodeNext",
    "sourceMap": true,
    "outDir": "./bin/.ts",
    "rootDir": "./",
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "downlevelIteration": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./",
    "paths": {
        "cc.decorator": [
            "cocos/core/data/decorators/index.ts"
        ]
    },
    "types": [
      "./node_modules/@cocos/cannon/CANNON",
      "./node_modules/@cocos/bullet/bullet",
      "./node_modules/@cocos/physx/PhysX",
      "./node_modules/@types/jest/index",

      // pal
      "./@types/pal/screen-adapter",
      "./@types/pal/minigame",
      "./@types/pal/audio",
      "./@types/pal/input",
      "./@types/pal/env",
      "./@types/pal/pacer",
    ]
  },
  "include": [
    "exports/**/*.ts",
    "typedoc-index.ts",
    "pal/**/*.ts",
    "node_modules/@types/internal/**/*.ts",
    "node_modules/@cocos/core/**/*.ts",
    "node_modules/@cocos/debug-infos/**/*.ts",
    "node_modules/@pal/system-info/**/*.ts"
  ]
}
